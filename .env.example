# Copy this file to .env and edit it, then run: docker compose up -d

# Timezone the bot uses for active_hours and night scavenging.
# Find yours at https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Amsterdam

# Port the dashboard is served on (http://localhost:5000/ by default).
PORT=5000

# Worlds to start automatically when the container boots, space separated.
# Leave empty on first run - create the world in the dashboard, then set it here
# so your bots come back by themselves after a reboot.
# Example: WORLDS=nl99 nl98
WORLDS=
