# Run TWB as a service on a Raspberry Pi, home server or VPS, so it starts at
# boot and restarts if it crashes.
#
# Install (adjust User and the two paths to match your setup):
#   sudo cp deploy/twb.service /etc/systemd/system/twb.service
#   sudo nano /etc/systemd/system/twb.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now twb
#
# Check on it:
#   systemctl status twb
#   journalctl -u twb -f
#
# This runs the dashboard, and the dashboard starts your world bots (either from
# its Start buttons, or set WORLDS below to bring them up automatically).

[Unit]
Description=TWB - Tribal Wars Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/TWB

# Space-separated worlds to start with the dashboard, e.g. "nl99 nl98".
Environment=WORLDS=
Environment=PORT=5000
Environment=PYTHONUNBUFFERED=1

ExecStart=/home/pi/TWB/docker/entrypoint.sh
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
